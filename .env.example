# ------ OLLAMA -------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
# rewrite model
# run on ollama
REWRITE_MODEL=qwen3:0.6b
# embedding model and host
# run with ollama
EMBED_HOST=http://localhost:11434
EMBED_MODEL=BGE-M3

# reranker model
# run with fastembed (hugging face model)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=20
# where the model will be cached
FASTEMBED_CACHE_PATH=data/models

# qdrant collection name
QDRANT_COLLECTION=chunks
QDRANT_URL=http://localhost:6333
QDRANT_HYBRID_COLLECTION=chunks_hybrid

# where you want to store
# your bm25 index
INDEX_DIR=data/processed/bm25_index/
# your chunks
CHUNKS_DIR=data/processed/chunks/

# BM25 stemmer language: the majority language of your corpus
# (e.g. 90% French -> french, mostly English -> english)
BM25_STEMMER_LANG=english

# ------ vLLM -------
VLLM_API_KEY=
VLLM_LLM_URL=http://localhost:8000/v1
VLLM_EMBED_URL=http://localhost:8001/v1
VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM_RERANK_URL=http://localhost:8002/v1
VLLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
