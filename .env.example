# ------ OLLAMA (--llm ollama) -------
# chat model (answer, rewrite)
OLLAMA_LLM_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:0.6b
# rewrite model (defaults to OLLAMA_LLM_MODEL)
OLLAMA_REWRITE_MODEL=qwen3:0.6b
# embedding model
OLLAMA_EMBED_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=BGE-M3

# ------ FASTEMBED (reranker with --llm ollama, runs locally) -------
FASTEMBED_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# where the model will be cached
FASTEMBED_CACHE_PATH=data/models

# ------ RERANK -------
RERANK_CANDIDATES=20

# ------ QDRANT -------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
QDRANT_HYBRID_COLLECTION=chunks_hybrid

# ------ BM25 -------
# where you want to store
# your bm25 index
BM25_INDEX_DIR=data/processed/bm25_index/
# your chunks
CHUNKS_DIR=data/processed/chunks/
# BM25 stemmer language: the majority language of your corpus
# (e.g. 90% French -> french, mostly English -> english)
BM25_STEMMER_LANG=english

# ------ vLLM (--llm vllm, default) -------
VLLM_API_KEY=
VLLM_LLM_URL=http://localhost:8000/v1
VLLM_LLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_EMBED_URL=http://localhost:8001/v1
VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM_RERANK_URL=http://localhost:8002/v1
VLLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
