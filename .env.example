# Local Ollama — run `ollama serve` before the app
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# BM25 stemmer language: the majority language of your corpus
# (e.g. 90% French -> "french", mostly English -> "english")
BM25_STEMMER_LANG="english"

# embedding model and host
EMBED_HOST="http://localhost:11434"
EMBED_MODEL="BGE-M3"

# qdrant collection name
QDRANT_COLLECTION="chunks"
QDRANT_URL="http://localhost:6333"

# where you want to store
# your bm25 index
INDEX_DIR="data/processed/bm25_index/"
# your chunks
CHUNKS_DIR="data/processed/chunks/"
